# Byte-compiled / Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Streamlit local state
.streamlit/

# SQLite Veritabanı ve Yerel Veriler (Hassas/Büyük veriler)
db/*.db
db/*.db-wal
db/*.db-shm
db/*.db-journal
data/*
!data/.gitkeep

# Sanal Ortam (Virtual Environment)
venv/
env/
.venv/

# Ortam değişkenleri / sırlar (henüz .env yok ama proaktif önlem)
.env
.env.*
!.env.example

# Proje köküne bilinçsizce bırakılmış / uygulamayla ilgisiz dosyalar
Yerel RAG.zip
kernel.errors.txt

# Derleme / paketleme kalıntıları
build/
dist/
*.egg-info/
.eggs/

# IDE / editör
.vscode/
.idea/
*.swp
*.swo

# Sistem Dosyaları
.DS_Store
Thumbs.db
desktop.ini

